# Copie para .env e ajuste os valores.
# Em produção, secrets via Docker Secrets; .env gitignored na VPS.

DJANGO_SETTINGS_MODULE=core.settings

# DEBUG=True em dev. Em produção use False.
DEBUG=True

# Secret key (gerar uma própria em produção; em dev pode usar a de exemplo)
SECRET_KEY=django-insecure-troque-por-uma-chave-secreta-real-em-producao-pcp-komotors

# Listas separadas por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Banco de dados. Default: SQLite local (arquivo db.sqlite3).
# Para PostgreSQL use: postgres://user:pass@host:5432/pcp
DATABASE_URL=sqlite:///%(BASE_DIR)s/db.sqlite3

# Cache / broker (a partir das sprints de Celery/IA)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# OpenAI (a partir da sprint de IA)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5-mini

# Login por email (auth custom)
AUTH_EMAIL_LOGIN=True